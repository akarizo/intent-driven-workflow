<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><!-- block:title -->意图审批面板<!-- /block:title --></title>
<style>
:root {
  color-scheme: light dark;

  --font-display: ui-serif, "Iowan Old Style", "Apple Garamond", Georgia, "Songti SC", "Source Han Serif SC", serif;
  --font-body:    -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --font-mono:    ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, "Source Han Mono SC", monospace;

  --space-1: clamp(0.25rem, 0.2rem + 0.2vw, 0.4rem);
  --space-2: clamp(0.5rem, 0.4rem + 0.4vw, 0.75rem);
  --space-3: clamp(0.75rem, 0.6rem + 0.6vw, 1.1rem);
  --space-4: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
  --space-5: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  --space-6: clamp(2.25rem, 1.8rem + 1.8vw, 3.5rem);
  --space-7: clamp(3.5rem, 2.8rem + 2.8vw, 5.5rem);

  --text-xs:   0.78rem;
  --text-sm:   0.875rem;
  --text-base: 1rem;
  --text-lg:   1.18rem;
  --text-xl:   1.45rem;
  --text-2xl:  1.85rem;
  --text-3xl:  2.4rem;
  --text-hero: clamp(2.6rem, 1.4rem + 5vw, 5.5rem);

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;

  --duration-fast: 140ms;
  --duration-base: 240ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

:root,
[data-theme="light"] {
  --color-bg:        #f7f5ef;
  --color-surface:   #ffffff;
  --color-surface-2: #efece3;
  --color-fg:        #15161a;
  --color-fg-muted:  #5b5e68;
  --color-border:    #d9d4c3;
  --color-border-strong: #1a1b20;
  --color-accent:    #1d4ed8;
  --color-accent-soft: #dbeafe;
  --color-new:       #15803d;
  --color-new-soft:  #dcfce7;
  --color-modified:  #b45309;
  --color-modified-soft: #fef3c7;
  --color-removed:   #b91c1c;
  --color-removed-soft: #fee2e2;
  --color-given:     #1d4ed8;
  --color-when:      #b45309;
  --color-then:      #15803d;
  --shadow-sm: 0 1px 2px rgba(20,21,26,.06);
  --shadow-md: 0 6px 24px -8px rgba(20,21,26,.16);
}

[data-theme="dark"] {
  --color-bg:        #0e0f13;
  --color-surface:   #16181d;
  --color-surface-2: #1d2027;
  --color-fg:        #f3f1e8;
  --color-fg-muted:  #9a9ea9;
  --color-border:    #2b2f37;
  --color-border-strong: #f3f1e8;
  --color-accent:    #60a5fa;
  --color-accent-soft: rgba(96,165,250,0.18);
  --color-new:       #4ade80;
  --color-new-soft:  rgba(74,222,128,0.16);
  --color-modified:  #fbbf24;
  --color-modified-soft: rgba(251,191,36,0.16);
  --color-removed:   #f87171;
  --color-removed-soft: rgba(248,113,113,0.18);
  --color-given:     #93c5fd;
  --color-when:      #fcd34d;
  --color-then:      #86efac;
  --shadow-sm: 0 1px 2px rgba(0,0,0,.35);
  --shadow-md: 0 10px 32px -10px rgba(0,0,0,.55);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --color-bg:        #0e0f13;
    --color-surface:   #16181d;
    --color-surface-2: #1d2027;
    --color-fg:        #f3f1e8;
    --color-fg-muted:  #9a9ea9;
    --color-border:    #2b2f37;
    --color-border-strong: #f3f1e8;
    --color-accent:    #60a5fa;
    --color-accent-soft: rgba(96,165,250,0.18);
    --color-new:       #4ade80;
    --color-new-soft:  rgba(74,222,128,0.16);
    --color-modified:  #fbbf24;
    --color-modified-soft: rgba(251,191,36,0.16);
    --color-removed:   #f87171;
    --color-removed-soft: rgba(248,113,113,0.18);
    --color-given:     #93c5fd;
    --color-when:      #fcd34d;
    --color-then:      #86efac;
  }
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-fg);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

a { color: var(--color-accent); text-decoration: none; }
a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }

code, pre { font-family: var(--font-mono); }
pre {
  background: var(--color-surface-2);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  overflow-x: auto;
  font-size: var(--text-sm);
}
:not(pre) > code {
  background: var(--color-surface-2);
  padding: 0.1em 0.4em;
  border-radius: var(--radius-sm);
  font-size: 0.92em;
}

/* ── Topbar ──────────────────────────────────────────────── */
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  background: color-mix(in oklab, var(--color-bg) 85%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
}
.topbar-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: var(--space-3) var(--space-5);
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.topbar .brand {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-lg);
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.topbar .brand-dot {
  width: 10px; height: 10px;
  background: var(--color-border-strong);
  border-radius: 50%;
}
.topbar .change-name {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  padding: var(--space-1) var(--space-2);
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-fg);
}
.topbar .chips {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-left: auto;
}
.chip {
  font-size: var(--text-xs);
  padding: var(--space-1) var(--space-2);
  border-radius: 999px;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-fg-muted);
  font-family: var(--font-mono);
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
}
.chip[data-state="done"]    { color: var(--color-new); border-color: var(--color-new); background: var(--color-new-soft); }
.chip[data-state="ready"]   { color: var(--color-accent); border-color: var(--color-accent); background: var(--color-accent-soft); }
.chip[data-state="blocked"] { color: var(--color-fg-muted); }
.theme-toggle {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-fg);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  cursor: pointer;
  transition: border-color var(--duration-fast) var(--ease-out);
}
.theme-toggle:hover { border-color: var(--color-border-strong); }

/* ── Layout ──────────────────────────────────────────────── */
.shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: var(--space-5);
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: var(--space-6);
}
@media (max-width: 900px) {
  .shell { grid-template-columns: 1fr; padding: var(--space-4); }
  .toc { position: static; max-height: none; }
}

.toc {
  position: sticky;
  top: 80px;
  align-self: start;
  max-height: calc(100vh - 100px);
  overflow-y: auto;
  padding-right: var(--space-2);
  border-right: 1px solid var(--color-border);
}
.toc h3 {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-fg-muted);
  margin: 0 0 var(--space-3);
}
.toc ol { list-style: none; padding: 0; margin: 0; counter-reset: toc; }
.toc li { counter-increment: toc; margin: var(--space-1) 0; }
.toc a {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  color: var(--color-fg-muted);
  font-size: var(--text-sm);
  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
}
.toc a:hover, .toc a[aria-current="true"] {
  background: var(--color-surface-2);
  color: var(--color-fg);
  text-decoration: none;
}
.toc a::before {
  content: counter(toc, decimal-leading-zero);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-fg-muted);
  min-width: 1.7em;
}

main { min-width: 0; }

/* ── Sections ────────────────────────────────────────────── */
section {
  margin-bottom: var(--space-7);
  scroll-margin-top: 100px;
}
section > h2 {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  letter-spacing: -0.01em;
  margin: 0 0 var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 2px solid var(--color-border-strong);
}
section > h2 .eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--color-fg-muted);
  margin-bottom: var(--space-2);
}
section h3 {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  margin: var(--space-5) 0 var(--space-2);
  font-weight: 600;
}
section h4 {
  font-family: var(--font-body);
  font-size: var(--text-lg);
  margin: var(--space-4) 0 var(--space-2);
  font-weight: 600;
}

/* Why — 克制层级：粗体衬线，但不放大字号 */
#why .why-statement {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 600;
  line-height: 1.5;
  color: var(--color-fg);
  margin: var(--space-2) 0 var(--space-3);
  max-width: 60ch;
}
#why .why-body {
  font-size: var(--text-base);
  color: var(--color-fg-muted);
  max-width: 60ch;
}

/* What */
#what ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: var(--space-2);
}
#what li {
  padding: var(--space-3) var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  border-radius: var(--radius-md);
}
#what .impact {
  margin-top: var(--space-5);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.tag {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  padding: var(--space-1) var(--space-2);
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-fg);
}

/* Capabilities — bento */
.cap-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--space-3);
}
.cap-card {
  padding: var(--space-4);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  position: relative;
  overflow: hidden;
}
.cap-card .cap-kind {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
}
.cap-card[data-kind="new"]      { border-left: 4px solid var(--color-new); }
.cap-card[data-kind="new"] .cap-kind { background: var(--color-new-soft); color: var(--color-new); }
.cap-card[data-kind="modified"] { border-left: 4px solid var(--color-modified); }
.cap-card[data-kind="modified"] .cap-kind { background: var(--color-modified-soft); color: var(--color-modified); }
.cap-card h4 {
  margin: 0 0 var(--space-2);
  padding-right: 5em;
  font-family: var(--font-mono);
  font-size: var(--text-lg);
}
.cap-card p { margin: 0; color: var(--color-fg-muted); }

/* Specs — Gherkin */
.spec-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
}
.spec-card h3 {
  margin: 0 0 var(--space-3);
  font-family: var(--font-mono);
  font-size: var(--text-lg);
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.spec-card h3 .delta {
  font-size: var(--text-xs);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.delta[data-op="added"]    { background: var(--color-new-soft); color: var(--color-new); }
.delta[data-op="modified"] { background: var(--color-modified-soft); color: var(--color-modified); }
.delta[data-op="removed"]  { background: var(--color-removed-soft); color: var(--color-removed); }

.requirement {
  padding: var(--space-3) 0;
  border-top: 1px dashed var(--color-border);
}
.requirement:first-of-type { border-top: 0; padding-top: 0; }
.requirement-name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 600;
  margin: 0 0 var(--space-2);
}
.scenario {
  background: var(--color-surface-2);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  margin: var(--space-3) 0;
}
.scenario-name {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-fg-muted);
  margin: 0 0 var(--space-2);
}
.steps { list-style: none; padding: 0; margin: 0; }
.steps li {
  padding: var(--space-1) 0;
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}
.step-key {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  min-width: 5em;
  text-align: center;
}
.step-key[data-kw="GIVEN"] { color: var(--color-given); background: var(--color-accent-soft); }
.step-key[data-kw="WHEN"]  { color: var(--color-when);  background: var(--color-modified-soft); }
.step-key[data-kw="THEN"]  { color: var(--color-then);  background: var(--color-new-soft); }
.step-key[data-kw="AND"],
.step-key[data-kw="BUT"]   { color: var(--color-fg-muted); background: var(--color-surface); }

/* Design */
#design .design-block {
  margin-bottom: var(--space-5);
}
#design details {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin: var(--space-2) 0;
}
#design details summary {
  cursor: pointer;
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 600;
}
#design details[open] summary { margin-bottom: var(--space-2); }

/* Mermaid */
.diagram-frame {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  margin: var(--space-3) 0;
  text-align: center;
  overflow-x: auto;
}
.diagram-frame .mermaid { font-family: var(--font-body); }
.diagram-frame .caption {
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-fg-muted);
  font-family: var(--font-mono);
}
.diagram-fallback {
  display: none;
  background: var(--color-surface-2);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--color-fg-muted);
}
body.offline .diagram-fallback { display: block; }
/* 渲染成功后 Mermaid 会打上 data-processed；未渲染的不外露源码 */
.diagram-frame .mermaid:not([data-processed]) { display: none; }

/* Mockups */
.mockup-frame {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  margin: var(--space-3) 0;
}
.mockup-frame .caption {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-fg-muted);
  margin-bottom: var(--space-3);
}

/* ADRs */
#adrs ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
#adrs li {
  display: flex;
  gap: var(--space-3);
  align-items: baseline;
  padding: var(--space-3);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
#adrs .adr-num {
  font-family: var(--font-mono);
  color: var(--color-fg-muted);
  font-size: var(--text-sm);
  min-width: 4em;
}
#adrs .adr-status {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  padding: var(--space-1) var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--color-accent-soft);
  color: var(--color-accent);
  margin-left: auto;
}

/* Tasks */
#tasks .task-group {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  margin: var(--space-2) 0;
}
#tasks .task-group summary {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: var(--text-lg);
  cursor: pointer;
}
#tasks ul { list-style: none; padding: var(--space-2) 0 0; margin: 0; }
#tasks li {
  display: flex;
  gap: var(--space-2);
  align-items: baseline;
  padding: var(--space-1) 0;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
}
#tasks input[type="checkbox"] {
  margin: 0;
  accent-color: var(--color-accent);
}
#tasks li[data-done="true"] { color: var(--color-fg-muted); text-decoration: line-through; }

/* Flight */
#flight h3 {
  font-family: var(--font-mono);
  font-size: var(--text-base);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-fg-muted);
  margin: var(--space-5) 0 var(--space-2);
}
.flight-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
  margin: var(--space-2) 0 var(--space-4);
}
.flight-table th, .flight-table td {
  padding: var(--space-2) var(--space-3);
  border-bottom: 1px solid var(--color-border);
  text-align: left;
  vertical-align: top;
}
.flight-table th {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-fg-muted);
}
.flight-table td.mono { font-family: var(--font-mono); }
.flight-table code {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  background: var(--color-surface-2);
  padding: 0 var(--space-1);
  border-radius: var(--radius-sm);
}
.chip[data-state="unlocked"] { color: var(--color-accent); border-color: var(--color-accent); background: var(--color-accent-soft); }
.chip[data-state="pending"]  { color: var(--color-modified); border-color: var(--color-modified); background: var(--color-modified-soft); }
.chip[data-state="passed"]   { color: var(--color-new); border-color: var(--color-new); background: var(--color-new-soft); }
.chip[data-state="missing"]  { color: var(--color-removed); border-color: var(--color-removed); background: var(--color-removed-soft); }

/* Placeholders (rendered as-is when block is not filled) */
.placeholder {
  padding: var(--space-3) var(--space-4);
  background: var(--color-surface-2);
  border-left: 3px dashed var(--color-fg-muted);
  color: var(--color-fg-muted);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  border-radius: var(--radius-sm);
}

/* Footer */
footer {
  border-top: 1px solid var(--color-border);
  padding: var(--space-5);
  text-align: center;
