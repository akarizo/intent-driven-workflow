    "merged-cleanup-agent-worktrees#cleanup-keeps-worktree-only-forked-from": "tests/test_merged_cleanup_landed.py::test_cleanup_keeps_worktree_only_forked_from",
    "merged-cleanup-agent-worktrees#cleanup-removes-dead-attempt-of-landed-change": "tests/test_merged_cleanup_landed.py::test_cleanup_removes_dead_attempt_of_landed_change",
