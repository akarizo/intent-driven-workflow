{
  "gate": {
    "test": "python3 -m pytest -q tests",
    "lint": "python3 -m compileall -q template/.claude/hooks",
    "typecheck": null,
    "checks": [
      {
        "name": "schema-validate",
        "baseline": "cd template && openspec schema validate intent-driven",
        "final": "cd template && openspec schema validate intent-driven",
        "timeout_sec": 120
      }
    ]
  },
  "slices": [
    {
      "id": "S1",
      "turns": "large",
      "title": "slice-gate.py reap：飞行收口回收本次飞行的临时 worktree（已落地复用 _reap_one；作废尝试先归档到 refs/flight/<change>/attic/；恒 exit 0 并记 reap 事件）",
      "packet": "slices/S1.md",
      "owns": [
        "template/.claude/hooks/slice-gate.py",
        "tests/test_close_reap.py"
      ],
      "deps": [],
      "verify": "python3 -m pytest -q tests/test_close_reap.py tests/test_merge_reap.py tests/test_slice_gate.py",
      "scenarios": [
        "flight-close-reap#close-reap-removes-landed-slice-worktree",
        "flight-close-reap#close-reap-ignores-worktrees-without-flight-evidence",
        "flight-close-reap#close-reap-skips-locked-worktree",
        "flight-close-reap#close-reap-archives-superseded-attempt",
        "flight-close-reap#close-reap-archives-uncommitted-work",
        "flight-close-reap#close-reap-keeps-worktree-with-own-submodule-clone",
        "flight-close-reap#close-reap-reports-and-records-timeline"
      ]
    },
    {
      "id": "S2",
      "title": "merged-cleanup.py：.claude/worktrees 下的 worktree 认 landed（被 merge 进其他本地分支）与 dead-attempt（属于已落地 / 已归档 change）",
      "packet": "slices/S2.md",
      "owns": [
        "template/.claude/hooks/merged-cleanup.py",
        "tests/test_merged_cleanup_landed.py"
      ],
      "deps": [],
      "verify": "python3 -m pytest -q tests/test_merged_cleanup_landed.py tests/test_merged_cleanup.py",
      "scenarios": [
        "merged-cleanup-agent-worktrees#cleanup-removes-worktree-merged-into-change-branch",
        "merged-cleanup-agent-worktrees#cleanup-keeps-worktree-only-forked-from",
        "merged-cleanup-agent-worktrees#cleanup-removes-dead-attempt-of-landed-change",
        "merged-cleanup-agent-worktrees#cleanup-defers-detached-dead-attempt",
        "merged-cleanup-agent-worktrees#cleanup-treats-archived-change-as-landed"
      ]
    },
    {
      "id": "S3",
      "title": "文档：opsx-apply 收口运行 reap（命令与 skill 同改）、clean-after-merged 原因表、铁律 6 与 README",
      "packet": "slices/S3.md",
      "owns": [
        "template/.claude/commands/opsx-apply.md",
        "template/.claude/skills/openspec-apply-change/SKILL.md",
        "template/.claude/commands/clean-after-merged.md",
        "CLAUDE.md",
        "template/CLAUDE.md.snippet",
        "README.md",
        "tests/test_close_reap_docs.py"
      ],
      "deps": [
        "S1",
        "S2"
      ],
      "verify": "python3 -m pytest -q tests/test_close_reap_docs.py tests/test_merge_reap.py tests/test_docs_iron_rules.py tests/test_template_docs.py tests/test_agents_workflow.py tests/test_audit_docs.py tests/test_audit_standard_docs.py tests/test_baseline_incremental_docs.py tests/test_budget_docs.py tests/test_clean_after_merged_docs.py tests/test_gate_checks_docs.py tests/test_glossary_docs.py tests/test_goal_takeoff_docs.py tests/test_guard_docs.py tests/test_incremental_final_docs.py tests/test_ledger_docs.py tests/test_lock_docs.py tests/test_plan_hygiene_docs.py tests/test_resume_docs.py tests/test_runner_contract_docs.py tests/test_scope_docs.py tests/test_ship_memory_docs.py tests/test_ship_rerun_docs.py tests/test_submodule_docs.py tests/test_template_docs.py tests/test_tiers_docs.py tests/test_tiers_parts_docs.py tests/test_wave_docs.py",
      "scenarios": [
        "flight-close-reap#apply-close-runs-reap",
        "flight-close-reap#iron-rule-names-close-reap",
        "merged-cleanup-agent-worktrees#cleanup-doc-explains-new-reasons"
      ]
    }
  ],
  "scenario_tests": {
    "flight-close-reap#close-reap-removes-landed-slice-worktree": "tests/test_close_reap.py::test_close_reap_removes_landed_slice_worktree",
