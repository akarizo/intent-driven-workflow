        "runner-statement#measured-baseline-rejects-leftover-statement",
        "runner-statement#final-refuses-unstated-unmeasured",
        "runner-statement#statement-may-be-prewritten-before-baseline",
        "runner-statement#incremental-baseline-keeps-unmeasured-state"
      ]
