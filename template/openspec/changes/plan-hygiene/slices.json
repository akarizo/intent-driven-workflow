        "S2"
      ],
      "verify": "python3 -m pytest -q tests/test_ship_forecast.py tests/test_ship_verdict.py tests/test_flight_doctor.py tests/test_flight_doctor_surfaces.py tests/test_final_reuse.py tests/test_spec_html.py",
      "scenarios": [
        "ship-rerun-forecast#stale-final-reason-says-incremental-rerun",
        "ship-rerun-forecast#stale-final-reason-says-full-rerun-with-why",
        "ship-rerun-forecast#forecast-reads-suite-sec-from-baseline"
