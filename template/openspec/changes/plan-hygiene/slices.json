    {
      "id": "S2",
      "title": "依赖图未测须表态：选测复核追加伪触发项 runner:deps-unmeasured（lint / preflight / final 开跑前复核，基线前为待定项并打印 runner: 提示），增量基线沿用来源的 deps_unmeasured",
      "packet": "slices/S2.md",
      "owns": [
        "template/.claude/hooks/slice-gate.py",
        "tests/test_runner_statement.py",
        "tests/test_slice_gate.py"
