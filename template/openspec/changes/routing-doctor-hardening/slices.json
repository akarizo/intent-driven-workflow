        "template/.claude/hooks/flight-doctor.py",
        "tests/test_routing_followups.py"
      ],
      "deps": [],
      "verify": "python3 -m pytest -q tests/test_routing_followups.py tests/test_routing_frontmatter.py tests/test_model_routing.py tests/test_flight_doctor.py tests/test_flight_doctor_lock.py tests/test_flight_doctor_tests.py",
