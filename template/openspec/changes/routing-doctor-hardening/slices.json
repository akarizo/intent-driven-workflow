      "scenarios": [
        "cleanup-doc-precision#cleanup-doc-marks-fork-command-untested"
      ]
    },
    {
      "id": "S3",
      "title": "model-routing.py init 种下 / 补全 model-routing.json（11 键全写、每键 desc、顶层 $comment），校验接受 desc / $comment；install 安装与升级运行 init；本仓库配置补全；README 同步",
      "packet": "slices/S3.md",
      "owns": [
        "template/.claude/hooks/model-routing.py",
        "template/openspec/model-routing.json",
        "install.sh",
        "README.md",
        "tests/test_routing_seed.py",
        "tests/test_install_routing.py"
      ],
      "deps": [
        "S1"
      ],
      "verify": "python3 -m pytest -q tests/test_routing_seed.py tests/test_install_routing.py tests/test_model_routing.py tests/test_routing_frontmatter.py tests/test_routing_followups.py tests/test_spec_html_routing.py tests/test_docs_iron_rules.py",
      "scenarios": [
        "routing-config-seeded#init-writes-full-config",
        "routing-config-seeded#init-fills-missing-keeps-values",
        "routing-config-seeded#init-leaves-invalid-config-untouched",
        "routing-config-seeded#install-seeds-routing-config"
      ]
    }
  ],
  "scenario_tests": {
